# CDS Journey — HER empty database (never the owner's Atlas / .env)
# Copy to server/.env  (from repo root:  node scripts/setup-demo-env.js)
# Never commit server/.env.

# --- Required ---
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
DEMO_MODE=1
ALLOW_ADMIN_SIGNUP=1

# YOUR MongoDB only. Do not paste anyone else's URI.
# Local empty DB:
MONGO_URI=mongodb://127.0.0.1:27017/cdsjourney-demo
# Or your own Atlas cluster (new cluster, not the owner's).

# setup-demo-env.js replaces CHANGE_ME_BEFORE_USE with a random value.
JWT_SECRET=CHANGE_ME_BEFORE_USE
JWT_EXPIRES_IN=7d

# Leave empty — create YOUR account on the login page (your email, your password).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

CLIENT_URL=http://localhost:5173
CORS_ALLOW_IP_ORIGINS=true
TELEGRAM_STREAM_CACHE=1

# Optional: folder for PDFs, stream cache, PC library.
# Leave unset to use the repo uploads/ directory.
# LOCAL_MEDIA_ROOT=C:\path\to\CDS UPLOAD

# --- Optional: Telegram (GramJS) — use YOUR Telegram, not the owner's ---
# Create an app at https://my.telegram.org then log in inside CDS Journey.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_AUTO_SYNC=false
# TELEGRAM_VIDEO_CLOUDIFY=0

# --- Optional: Cloudinary (your accounts) ---
# CLOUDINARY_CLOUDS=cloud1
# CLOUDINARY_DEFAULT_CLOUD=cloud1
# CLOUDINARY_CLOUD1_NAME=
# CLOUDINARY_CLOUD1_API_KEY=
# CLOUDINARY_CLOUD1_API_SECRET=

# --- Optional: OpenAI (your key) ---
# OPENAI_API_KEY=
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# --- Optional: Google YouTube OAuth (your client) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/youtube/callback
