{
  "manifest_version": 3,
  "name": "CDS Journey YouTube Study Tracker",
  "version": "1.3.1",
  "description": "Count study minutes on youtube.com. Click Track on the video — pauses when you pause. No need to open the CDS app.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "action": {
    "default_title": "CDS Journey YouTube Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["youtube.js"],
      "css": ["youtube-ui.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["youtube-ui.css"],
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]
    }
  ]
}
