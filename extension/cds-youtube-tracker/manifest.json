{
  "manifest_version": 3,
  "name": "CDS Journey Study Video Tracker",
  "version": "1.6.1",
  "description": "Count study minutes on any course video — YouTube, embedded players, and other platforms. Click Track on the video; pauses when you pause.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "CDS Journey Video Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5001/*",
        "http://127.0.0.1:5001/*"
      ],
      "js": ["video-tracker.js"],
      "css": ["video-tracker-ui.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["video-tracker-ui.css"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ]
}
