# CDS Journey — client demo / local template
# Copy to client/.env  (from repo root:  node scripts/setup-demo-env.js)
#
# Local Vite already proxies /api and /uploads to http://127.0.0.1:5001.
# Leave these commented unless the API is on another host.

# VITE_API_URL=http://localhost:5001/api
# VITE_SERVER_URL=http://localhost:5001
